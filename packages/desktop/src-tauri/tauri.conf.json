{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vox",
  "version": "0.1.0",
  "identifier": "app.vox.client",
  "build": {
    "beforeDevCommand": "npm run dev --workspace=@vox/web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --workspace=@vox/web",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vox",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws: wss: http: https:; media-src 'self' blob:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
