# Copie para .env antes de subir com TLS.

# Dominio que ja aponta (registro A/AAAA) para este servidor.
VOX_DOMAIN=voz.seudominio.com

VOX_NAME=Servidor Vox
VOX_MOTD=Bem-vindo.
VOX_BASE_DOMAIN=v0x.online

# Vazio = servidor aberto.
VOX_PASSWORD=

VOX_MAX_CLIENTS=128

# Se o Vox estiver atrás de Caddy/Nginx, descomente para contabilizar o IP real
# de cada cliente. Só use quando o proxy for confiável e estiver na frente do Vox.
# VOX_TRUST_PROXY=1

# Vazio = painel admin desligado.
VOX_ADMIN_PASSWORD=

# Checkout Pro do Mercado Pago (opcional; deixe vazio até configurar a conta).
# O Access Token e a assinatura secreta nunca devem entrar no Git.
# VOX_MP_ACCESS_TOKEN=
# VOX_MP_WEBHOOK_SECRET=
# Preços mensais em reais. O Rubinot é sempre um adicional de R$ 80,00.
# Estes valores já têm fallback no código, mas podem ser personalizados na VPS.
# VOX_MP_50_PRICE=35.00
# VOX_MP_100_PRICE=65.00
# VOX_MP_200_PRICE=130.00
# VOX_MP_300_PRICE=180.00
# VOX_MP_BOT_ADDON_PRICE=80.00
# VOX_PUBLIC_ORIGIN=https://v0x.online
# VOX_MP_WEBHOOK_URL=https://v0x.online/api/payments/mercadopago/webhook

# Voz QUIC/WebTransport para instalação atrás de Caddy.
# O Caddy emite um certificado por hostname sob demanda. O Vox abre listeners
# UDP automaticamente para novos hostnames; libere todo o intervalo no firewall.
# VOX_WT_PORT=9987
# VOX_WT_PORT_MAX=10086
# VOX_WT_HOST=0.0.0.0
# VOX_WT_CERT_DIR=/var/lib/caddy/.local/share/caddy/certificates/acme-v02.api.letsencrypt.org-directory
# VOX_WT_CERT=/caminho/para/hostname.crt
# VOX_WT_KEY=/caminho/para/hostname.key

# Plano de mídia separado (opcional durante a migração). O Node continua
# funcionando no caminho atual quando o binário não estiver instalado.
# VOX_VOICE_ROUTER_ENABLED=1
# VOX_VOICE_ROUTER_BIN=/usr/local/bin/vox-voice-router
# VOX_VOICE_ROUTER_LISTEN=127.0.0.1:19876
# VOX_VOICE_ROUTER_TARGET=127.0.0.1:19877
# VOX_VOICE_ROUTER_WORKERS=4
# VOX_VOICE_ROUTER_MANAGED_EXTERNALLY=1

# Terminador WebTransport em Rust (fase seguinte, desligado por padrão).
# O host/porta abaixo são públicos; o controle UDP é somente localhost.
# VOX_VOICE_QUIC_GATEWAY_ENABLED=0
# VOX_VOICE_QUIC_GATEWAY_HOST=manowar.v0x.online
# VOX_VOICE_QUIC_GATEWAY_PORT=9988
# VOX_VOICE_QUIC_GATEWAY_REGION=Origem Rust
# VOX_VOICE_QUIC_GATEWAY_CONTROL=127.0.0.1:19878
