# Copie para .env antes de subir com TLS.

# Dominio que ja aponta (registro A/AAAA) para este servidor.
VOX_DOMAIN=voz.seudominio.com

VOX_NAME=Servidor Vox
VOX_MOTD=Bem-vindo.
VOX_BASE_DOMAIN=v0x.online

# Vazio = servidor aberto.
VOX_PASSWORD=

VOX_MAX_CLIENTS=128

# Vazio = painel admin desligado.
VOX_ADMIN_PASSWORD=

# Checkout Pro do Mercado Pago (opcional; deixe vazio até configurar a conta).
# O Access Token e a assinatura secreta nunca devem entrar no Git.
# VOX_MP_ACCESS_TOKEN=
# VOX_MP_WEBHOOK_SECRET=
# Preços mensais em reais.
# VOX_MP_50_NO_BOT_PRICE=29.90
# VOX_MP_50_BOT_PRICE=69.90
# VOX_MP_100_NO_BOT_PRICE=50.90
# VOX_MP_100_BOT_PRICE=99.90
# VOX_MP_254_NO_BOT_PRICE=100.00
# VOX_MP_254_BOT_PRICE=150.00
# VOX_PUBLIC_ORIGIN=https://v0x.online
# VOX_MP_WEBHOOK_URL=https://v0x.online/api/payments/mercadopago/webhook

# Voz QUIC/WebTransport para instalação atrás de Caddy.
# O Caddy emite um certificado por hostname sob demanda. O Vox abre listeners
# UDP automaticamente para novos hostnames; libere todo o intervalo no firewall.
# VOX_WT_PORT=9987
# VOX_WT_PORT_MAX=10086
# VOX_WT_HOST=0.0.0.0
# VOX_WT_CERT_DIR=/var/lib/caddy/.local/share/caddy/certificates/acme-v02.api.letsencrypt.org-directory
# VOX_WT_CERT=/caminho/para/hostname.crt
# VOX_WT_KEY=/caminho/para/hostname.key
