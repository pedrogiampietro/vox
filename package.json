{
  "name": "vox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=@vox/server",
    "dev:web": "npm run dev --workspace=@vox/web",
    "dev:panel": "npm run dev --workspace=@vox/panel",
    "dev:desktop": "npm run dev --workspace=@vox/desktop",
    "music-bot": "npm run music-bot --workspace=@vox/bot --",
    "music-jukebox": "npm run music-jukebox --workspace=@vox/bot",
    "probe:deus": "npm run probe-deus --workspace=@vox/bot",
    "solve:deus": "npm run solve-deus-challenge --workspace=@vox/bot",
    "build:web": "npm run build --workspace=@vox/web",
    "build:panel": "npm run build --workspace=@vox/panel",
    "build:server": "esbuild packages/server/src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server.mjs --external:@fails-components/* --external:bufferutil --external:utf-8-validate --external:cycletls --external:form-data --external:cloakbrowser --external:cloakbrowser/* --external:playwright-core --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "build:edge": "esbuild packages/edge/src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/edge.mjs --external:@fails-components/* --external:bufferutil --external:utf-8-validate --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "build:voice-router": "cargo build --release --manifest-path packages/voice-router/Cargo.toml",
    "test:voice-router": "cargo test --manifest-path packages/voice-router/Cargo.toml",
    "build:voice-quic": "cargo build --release --manifest-path packages/voice-quic/Cargo.toml",
    "test:voice-quic": "cargo test --manifest-path packages/voice-quic/Cargo.toml",
    "build": "npm run build:web && npm run build:panel && npm run build:server && npm run build:edge",
    "start": "node dist/server.mjs",
    "typecheck": "tsc -p packages/protocol && tsc -p packages/bot && tsc -p packages/server && tsc -p packages/web && tsc -p packages/panel && tsc -p packages/edge",
    "smoke": "tsx packages/server/scripts/smoke.ts",
    "smoke:claims": "tsx packages/server/scripts/claims-smoke.ts",
    "stress": "tsx packages/server/scripts/stress.ts",
    "stress:matrix": "tsx packages/server/scripts/stress-matrix.ts",
    "stress:capacity": "tsx packages/server/scripts/stress-capacity.ts",
    "check:voice-stats": "tsx packages/web/scripts/voice-stats-check.ts"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
