[Unit]
Description=Vox regional voice edge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/vox
EnvironmentFile=/etc/vox-edge.env
ExecStart=/usr/bin/node /opt/vox/dist/edge.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
